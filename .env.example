API_BASE_URL=http://localhost:8000/api/v1

# Screener / symbol-feed WebSocket (the bot's symbol source)
#
# !! screener.depthsight.pro is the UPSTREAM DepthSight-Pro deployment's
# !! RESERVED HOSTNAME. It is NOT this fork's deployment: this fork never
# !! controlled that DNS, and the host returns HTTP 525. Never point
# !! MAIN_APP_WS_URL at it. The bot would reconnect against it forever, and
# !! every DYNAMIC-mode strategy would run with zero symbols and silently
# !! never trade -- which looks healthy, and is the worst failure mode this
# !! product has.
# !!
# !! MAIN_APP_WS_URL therefore has NO default in the source
# !! (bot_module/config.py) on purpose: an inherited upstream URL is a
# !! footgun. It has NO default HERE either, for the same reason: the only
# !! host this fork ships is its own frontend socket, and that socket cannot
# !! deliver a symbol to the bot.
# !!
# !! READ THIS BEFORE ENABLING DYNAMIC SYMBOL SELECTION:
# !! the bot's screener client speaks the bot protocol -- it expects
# !! {"type": "active_pairs_update", "data": [...]} messages
# !! (bot_module/data_consumer.py). This fork's own /ws is the FRONTEND's
# !! endpoint: it is token-authenticated and it forwards Redis channel
# !! messages as {"topic": ..., "payload": ...}. Nothing in this repository
# !! publishes "active_pairs_update" -- its producer was the upstream's
# !! separate screener service, which this fork does not run
# !! (docker-compose.yml has no screener service). So a DYNAMIC deployment
# !! still needs a screener that speaks the bot protocol; pointing this at
# !! the fork's own /ws will connect and then deliver no symbols.
# !! Until such a producer exists, run STATIC/FIXED strategies (explicit
# !! symbols) or SYMBOL_SOURCE_MODE='STATIC_LIST'.
# !!
# !! The bot REFUSES a DYNAMIC-mode strategy when this feed cannot deliver a
# !! symbol: when the URL is empty, when it is not a ws:// / wss:// URL, when
# !! it names the upstream's reserved hostname, when it names this fork's own
# !! frontend socket (/ws, /ws/main), and when the feed is switched off
# !! (bot_module/screener_feed.py). So a DYNAMIC strategy can never be
# !! reported "running" against a feed that cannot deliver.
MAIN_APP_WS_URL=
# The screener WebSocket loop is OFF by default (same safe default as the
# upstream project). Turn it on deliberately, once MAIN_APP_WS_URL points at
# a feed that actually answers and speaks the bot protocol.
MAIN_APP_WS_ENABLED=false
# Where the bot gets its symbol list from:
#   MAIN_APP     - the screener WebSocket feed above (needs MAIN_APP_WS_URL
#                  and MAIN_APP_WS_ENABLED=true; there is NO automatic
#                  fallback to the static list)
#   STATIC_LIST  - the static list in bot_module/config.py
#   JSON_FILE    - a JSON array of symbols on disk
SYMBOL_SOURCE_MODE=MAIN_APP

