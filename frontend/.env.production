# Frontend production env (baked into the JS bundle at build time)
# These are public values only - never put real secrets here

VITE_API_BASE_URL=/api/v1
VITE_WS_URL=wss://depthsight.diverseinc.net/ws
VITE_PUBLIC_API_URL=https://depthsight.diverseinc.net

VITE_APP_URL=https://depthsight.diverseinc.net
VITE_SUPPORT_EMAIL=support@diverseinc.net
VITE_TELEGRAM_URL=https://t.me/diverseinc

VITE_GOOGLE_CLIENT_ID=965936800422-a3agu6511s1630nqrme3ihgdeshqa85c.apps.googleusercontent.com

# Federation disabled on self-hosted. The default hubApiUrl points at
# app.depthsight.pro which is CORS-blocked; enabling it would spam the
# browser console with ERR_FAILED every 30s. Set VITE_HUB_ENABLED=true on
# the official depthsight.pro deployment if you want the live network map.
VITE_HUB_ENABLED=false
