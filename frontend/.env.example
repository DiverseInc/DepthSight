# Frontend Environment Variables
# URL for the API
VITE_API_BASE_URL=/api/v1
# WebSocket URL
VITE_WS_URL=ws://localhost:8765/ws
VITE_PUBLIC_API_URL=http://localhost:8000

# Public App Information
VITE_APP_URL=https://depthsight.pro
VITE_SUPPORT_EMAIL=support@depthsight.pro
VITE_TELEGRAM_URL=https://t.me/depthsight

# Google OAuth
VITE_GOOGLE_CLIENT_ID=replace_with_your_google_client_id.apps.googleusercontent.com

# Federation / central hub
# Set to "true" only on deployments that want the live network map of nodes
# (e.g. the official app.depthsight.pro). Self-hosted deployments should leave
# this unset or "false" — the default hubApiUrl is CORS-blocked from outside
# origins, so leaving it enabled would spam the console with ERR_FAILED.
VITE_HUB_ENABLED=false
VITE_HUB_API_URL=
